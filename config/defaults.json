{
    "providers": {
        "ollama": {
            "name": "Ollama (Local)",
            "description": "Run models locally via Ollama — no API key needed",
            "baseUrl": "http://localhost:11434/v1",
            "apiKeyEnvVar": null,
            "requiresApiKey": false,
            "api": "openai-completions",
            "supportsModelDiscovery": true,
            "curatedModels": [
                {"id": "qwen3:latest", "name": "Qwen 3 (General)", "recommended": true},
                {"id": "llama3.2:latest", "name": "Llama 3.2 (General)"},
                {"id": "gemma3:latest", "name": "Gemma 3 (General)"},
                {"id": "deepseek-r1:latest", "name": "DeepSeek R1 (Reasoning)", "reasoning": true},
                {"id": "qwen3-coder:latest", "name": "Qwen 3 Coder (Programming)"},
                {"id": "gpt-oss:latest", "name": "GPT OSS (Coding)"},
                {"id": "devstral:latest", "name": "Devstral (Coding Agents)"},
                {"id": "qwen3-vl:latest", "name": "Qwen 3 VL (Vision)", "vision": true},
                {"id": "llama3.2-vision:latest", "name": "Llama 3.2 Vision", "vision": true},
                {"id": "mistral:latest", "name": "Mistral 7B (Fast)"},
                {"id": "phi4:latest", "name": "Phi 4 (Compact)"},
                {"id": "glm-4.7-flash:latest", "name": "GLM 4.7 Flash (Fast)"},
                {"id": "tinyllama:latest", "name": "TinyLlama (Ultra Fast)"}
            ]
        },
        "openai": {
            "name": "OpenAI",
            "description": "GPT models via OpenAI API — requires API key",
            "baseUrl": "https://api.openai.com/v1",
            "apiKeyEnvVar": "OPENAI_API_KEY",
            "requiresApiKey": true,
            "api": "openai-completions",
            "supportsModelDiscovery": true,
            "curatedModels": [
                {"id": "gpt-5.2", "name": "GPT-5.2 (Flagship)", "recommended": true},
                {"id": "gpt-5-mini", "name": "GPT-5 Mini (Fast)"},
                {"id": "gpt-5-nano", "name": "GPT-5 Nano (Cheapest)"},
                {"id": "gpt-4.1", "name": "GPT-4.1 (Non-Reasoning)"},
                {"id": "gpt-4.1-mini", "name": "GPT-4.1 Mini"},
                {"id": "gpt-4o", "name": "GPT-4o (Legacy)"},
                {"id": "gpt-4o-mini", "name": "GPT-4o Mini (Legacy)"}
            ]
        },
        "anthropic": {
            "name": "Anthropic",
            "description": "Claude models via Anthropic API — requires API key",
            "baseUrl": "https://api.anthropic.com/v1",
            "apiKeyEnvVar": "ANTHROPIC_API_KEY",
            "requiresApiKey": true,
            "api": "anthropic",
            "supportsModelDiscovery": false,
            "curatedModels": [
                {"id": "claude-opus-4-6", "name": "Claude Opus 4.6 (Most Intelligent)", "recommended": true},
                {"id": "claude-sonnet-4-5", "name": "Claude Sonnet 4.5 (Balanced)"},
                {"id": "claude-haiku-4-5", "name": "Claude Haiku 4.5 (Fastest)"}
            ]
        },
        "openrouter": {
            "name": "OpenRouter",
            "description": "Access multiple providers through one API — requires API key",
            "baseUrl": "https://openrouter.ai/api/v1",
            "apiKeyEnvVar": "OPENROUTER_API_KEY",
            "requiresApiKey": true,
            "api": "openai-completions",
            "supportsModelDiscovery": true,
            "curatedModels": [
                {"id": "anthropic/claude-opus-4-6", "name": "Claude Opus 4.6 via OpenRouter"},
                {"id": "openai/gpt-5.2", "name": "GPT-5.2 via OpenRouter"},
                {"id": "google/gemini-2.5-flash", "name": "Gemini 2.5 Flash via OpenRouter"},
                {"id": "meta-llama/llama-3.3-70b-instruct", "name": "Llama 3.3 70B via OpenRouter"}
            ]
        },
        "xai": {
            "name": "xAI (Grok)",
            "description": "Grok models via xAI API — requires API key",
            "baseUrl": "https://api.x.ai/v1",
            "apiKeyEnvVar": "XAI_API_KEY",
            "requiresApiKey": true,
            "api": "openai-completions",
            "supportsModelDiscovery": true,
            "curatedModels": [
                {"id": "grok-4", "name": "Grok 4 (Flagship Reasoning)", "recommended": true},
                {"id": "grok-4-1-fast-reasoning", "name": "Grok 4.1 Fast (Reasoning)"},
                {"id": "grok-3", "name": "Grok 3 (Previous Gen)"},
                {"id": "grok-3-mini", "name": "Grok 3 Mini (Fast)"},
                {"id": "grok-2-vision-1212", "name": "Grok 2 Vision (Image Understanding)", "vision": true}
            ]
        },
        "gemini": {
            "name": "Google Gemini",
            "description": "Gemini models via Google AI API — requires API key",
            "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
            "apiKeyEnvVar": "GEMINI_API_KEY",
            "requiresApiKey": true,
            "api": "gemini",
            "supportsModelDiscovery": true,
            "curatedModels": [
                {"id": "gemini-2.5-pro", "name": "Gemini 2.5 Pro (Flagship)", "recommended": true},
                {"id": "gemini-2.5-flash", "name": "Gemini 2.5 Flash (Fast)"},
                {"id": "gemini-2.5-flash-lite", "name": "Gemini 2.5 Flash Lite (Cheapest)"},
                {"id": "gemini-3.1-pro-preview", "name": "Gemini 3.1 Pro Preview (Next-gen Flagship)"},
                {"id": "gemini-3-flash-preview", "name": "Gemini 3 Flash Preview (Next-gen Fast)"},
                {"id": "gemini-3.1-flash-lite-preview", "name": "Gemini 3.1 Flash Lite Preview (Next-gen Cheapest)"}
            ]
        },
        "mistral": {
            "name": "Mistral AI",
            "description": "Mistral models via Mistral API — requires API key",
            "baseUrl": "https://api.mistral.ai/v1",
            "apiKeyEnvVar": "MISTRAL_API_KEY",
            "requiresApiKey": true,
            "api": "openai-completions",
            "supportsModelDiscovery": true,
            "curatedModels": [
                {"id": "mistral-large-latest", "name": "Mistral Large (Flagship)", "recommended": true},
                {"id": "mistral-medium-latest", "name": "Mistral Medium (Balanced)"},
                {"id": "mistral-small-latest", "name": "Mistral Small (Fast)"},
                {"id": "codestral-latest", "name": "Codestral (Code Generation)"},
                {"id": "pixtral-large-latest", "name": "Pixtral Large (Vision)", "vision": true}
            ]
        },
        "minimax": {
            "name": "MiniMax",
            "description": "MiniMax models via MiniMax API — requires API key",
            "baseUrl": "https://api.minimaxi.com/v1",
            "apiKeyEnvVar": "MINIMAX_API_KEY",
            "requiresApiKey": true,
            "api": "openai-completions",
            "supportsModelDiscovery": false,
            "curatedModels": [
                {"id": "minimax-01", "name": "MiniMax-01 (Flagship)", "recommended": true},
                {"id": "minimax-text-01", "name": "MiniMax Text 01"},
                {"id": "abab7-chat-preview", "name": "ABAB 7 Chat (Preview)"}
            ]
        }
    },
    "roles": {
        "orchestrator": {
            "description": "Routes tasks and handles simple queries — use a fast, cost-effective model",
            "required": true
        },
        "coder": {
            "description": "Writes and refactors code — use a strong coding model",
            "required": false
        },
        "reviewer": {
            "description": "Reviews code for bugs, security, and style — use a reasoning model",
            "required": false
        },
        "vision": {
            "description": "Analyzes images — use a vision-capable model (e.g. gemini/gemini-2.5-flash)",
            "required": false
        },
        "title-generator": {
            "description": "Generates session titles — use a fast, cheap model. Also used for summarization and memory compression unless agents.defaults.model.utility is set",
            "required": false
        }
    },
    "defaults": {
        "model": "ollama/qwen3:latest",
        "workspace": "~/.coqui/.workspace"
    }
}

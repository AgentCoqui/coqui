{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coqui.dev/spec/schema/turn.json",
  "title": "Turn",
  "description": "One user-prompt to agent-response cycle within a Session. MAY span multiple model iterations and tool calls. Normative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "turn_number", "user_prompt", "status", "created_at"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/Id" },
    "session_id": { "$ref": "common.json#/$defs/Id" },
    "actor_persona_id": { "oneOf": [ { "$ref": "common.json#/$defs/Id" }, { "type": "null" } ], "description": "The member persona that produced this turn. REQUIRED in a group session (422 missing_field if absent); null/absent in a solo session." },
    "turn_number": { "type": "integer", "minimum": 1 },
    "user_prompt": { "type": "string" },
    "response_text": { "type": ["string", "null"] },
    "model": { "$ref": "common.json#/$defs/ModelId" },
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "iterations": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "tools_used": { "type": ["array", "null"], "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["running", "completed", "failed", "cancelled"] },
    "created_at": { "$ref": "common.json#/$defs/Timestamp" },
    "completed_at": { "$ref": "common.json#/$defs/NullableTimestamp" }
  }
}

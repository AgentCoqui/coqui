{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coqui.dev/spec/schema/job.json",
  "title": "Job",
  "description": "The async unit a Turn or Loop Stage runs on. Internal (diagnostics-only). Normative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "status", "prompt", "role", "max_iterations", "created_at"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/Id" },
    "session_id": { "$ref": "common.json#/$defs/Id" },
    "parent_session_id": { "oneOf": [ { "$ref": "common.json#/$defs/Id" }, { "type": "null" } ] },
    "status": { "type": "string", "enum": ["pending","running","completed","failed","cancelled"] },
    "title": { "type": ["string","null"] },
    "prompt": { "type": "string" },
    "role": { "type": "string" },
    "metadata": { "type": ["object","null"] },
    "result": { "type": ["string","null"] },
    "error": { "type": ["string","null"] },
    "max_iterations": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "common.json#/$defs/Timestamp" },
    "started_at": { "$ref": "common.json#/$defs/NullableTimestamp" },
    "completed_at": { "$ref": "common.json#/$defs/NullableTimestamp" },
    "cancelled_at": { "$ref": "common.json#/$defs/NullableTimestamp" }
  }
}

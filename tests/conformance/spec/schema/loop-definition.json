{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coqui.dev/spec/schema/loop-definition.json",
  "title": "LoopDefinition",
  "description": "A reusable, user-authorable Loop template: an ordered role-chain plus a termination condition. Normative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "roles", "termination_condition", "version"],
  "properties": {
    "name": { "$ref": "common.json#/$defs/Slug" },
    "version": { "type": "integer", "minimum": 1, "description": "Opaque optimistic-concurrency token; server-assigned, increments on each update. Clients send the current value as If-Match on mutation; a mismatch returns 409 version_conflict." },
    "description": { "type": "string" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "prompt", "order"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "description": "Role name; MUST be within the executing persona's allowed_roles." },
          "prompt": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "gate": { "type": "boolean", "default": false },
          "artifact_required": { "type": "boolean", "default": false },
          "memory_required": { "type": "boolean", "default": false }
        }
      }
    },
    "termination_condition": {
      "type": "object",
      "oneOf": [
        { "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "const": "iteration_bound" }, "value": { "type": "integer", "minimum": 1 } } },
        { "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "const": "evaluation_bound" },
            "value": { "type": "object", "additionalProperties": false, "required": ["criteria", "max_review_rounds"],
              "properties": { "criteria": { "type": "string" }, "max_review_rounds": { "type": "integer", "minimum": 1 } } } } },
        { "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "const": "goal_bound" },
            "value": { "type": "object", "additionalProperties": false, "required": ["goal_prompt", "max_iterations"],
              "properties": { "goal_prompt": { "type": "string" }, "max_iterations": { "type": "integer", "minimum": 1 } } } } }
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {}
        }
      }
    },
    "max_rework_attempts": { "type": "integer", "minimum": 1, "default": 3 }
  }
}

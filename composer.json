{
  "name": "coquibot/coqui",
  "description": "Terminal AI agent REPL with multi-model orchestration and persistent sessions",
  "version": "0.0.1",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Carmelo Santana"
    }
  ], 
  "require": {
    "php": "^8.4",
    "ext-pdo_sqlite": "*",
    "carmelosantana/php-agents": "^0.12",
    "dragonmantank/cron-expression": "^3.0",
    "league/commonmark": "^2.8",
    "react/async": "^4",
    "react/child-process": "^0.6",
    "react/http": "^1.11",
    "symfony/console": "^8.0",
    "symfony/http-client": "^8.0",
    "yethee/tiktoken": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.0"
  },
  "suggest": {
    "ext-pcntl": "Required for background task cancellation via SIGTERM",
    "ext-posix": "Required for background task process management"
  },
  "autoload": {
    "psr-4": {
      "CoquiBot\\Coqui\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoquiBot\\Coqui\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/coqui"
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "@php scripts/test-coverage.php",
    "test:coverage:ci": "@php scripts/test-coverage.php --clover build/coverage/clover.xml",
    "test-bash": "bash tests/bash/launcher-sigint-test.sh",
    "lint-bash": "shellcheck bin/coqui-launcher tests/bash/launcher-sigint-test.sh scripts/build.sh scripts/ci-test.sh scripts/sync-workspace-toolkits.sh",
    "analyse": "phpstan analyse --memory-limit=512M"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

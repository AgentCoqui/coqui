{
  "name": "coquibot/coqui",
  "description": "Terminal AI agent REPL with multi-model orchestration and persistent sessions",
  "version": "0.1.0",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Carmelo Santana"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-pdo_sqlite": "*",
    "carmelosantana/php-agents": "^0.6",
    "coquibot/coqui-toolkit-composer": "^0.1",
    "coquibot/coqui-toolkit-packagist": "^0.1",
    "react/http": "^1.11",
    "symfony/console": "^7.0"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "suggest": {
    "ext-pcntl": "Required for background task cancellation via SIGTERM",
    "ext-posix": "Required for background task process management"
  },
  "autoload": {
    "psr-4": {
      "CoquiBot\\Coqui\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoquiBot\\Coqui\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/coqui"
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

{
  "name": "coquibot/coqui",
  "description": "Personal operating system — lightweight agent runtime with multi-model orchestration and persistent sessions",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Carmelo Santana"
    }
  ],
  "repositories": [
    {
        "type": "path",
        "url": "../php-agents",
        "options": {
            "symlink": true
        }
    },
    {
        "type": "path",
        "url": "../../Toolkits/coqui-toolkit-images",
        "options": {
            "symlink": true
        }
    }
  ],  
  "require": {
    "php": "^8.4",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "ext-xml": "*",
    "carmelosantana/coqui-toolkit-images": "@dev",
    "carmelosantana/php-agents": "@dev",
    "dragonmantank/cron-expression": "^3.0",
    "league/commonmark": "^2.8",
    "league/html-to-markdown": "^5.1",
    "phpoffice/phpword": "^1.0",
    "react/async": "^4",
    "react/child-process": "^0.6",
    "react/http": "^1.11",
    "smalot/pdfparser": "^2.0",
    "symfony/console": "^8.0",
    "symfony/http-client": "^8.0",
    "yethee/tiktoken": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.0"
  },
  "suggest": {
    "ext-gd": "Recommended for bundled image previews in coqui-toolkit-images and for release or Docker build parity",
    "ext-zip": "Required for optional .odt/.ods/.odp/.xlsx/.pptx backstory extraction",
    "ext-pcntl": "Required for background task cancellation via SIGTERM",
    "ext-posix": "Required for background task process management"
  },
  "autoload": {
    "psr-4": {
      "CoquiBot\\Coqui\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoquiBot\\Coqui\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "tests/Unit/Config/ToolkitDiscoveryTest.php"
    ]
  },
  "bin": [
    "bin/coqui"
  ],
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "generate:model-defaults": "@php scripts/generate-model-defaults.php --write",
    "test": "pest",
    "test:coverage": "@php scripts/test-coverage.php",
    "test-bash": "bash tests/bash/launcher-sigint-test.sh",
    "lint-bash": "shellcheck bin/coqui-launcher tests/bash/launcher-sigint-test.sh scripts/build.sh scripts/ci-test.sh scripts/sync-workspace-toolkits.sh",
    "analyse": "phpstan analyse --memory-limit=512M"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

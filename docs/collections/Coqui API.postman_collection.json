						},
						"url": {
							"raw": "{{base_url}}/api/sessions",
							"host": ["{{base_url}}"],
							"path": ["api", "sessions"]
						},
						"description": "Create a new session. The model_role field is optional and defaults to \"orchestrator\". The session ID is automatically saved to the session_id collection variable."

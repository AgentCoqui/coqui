			"item": [
				{
					"name": "Health Check",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/health",
							"host": ["{{base_url}}"],
							"path": ["api", "health"]
						},
						"description": "Server liveness check. Returns status, version, uptime, and the number of currently active agent sessions. Does not require authentication."
					},
					"response": [
						{
							"name": "Health Check — OK",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"status\": \"ok\",\n  \"version\": \"dev\",\n  \"uptime_seconds\": 3421,\n  \"active_sessions\": 1\n}"
						}
					]
				}
			]
		},

				{
					"name": "Send Prompt (SSE Stream)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "text/event-stream"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"prompt\": \"What files are in the src directory?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/sessions/{{session_id}}/messages",
							"host": ["{{base_url}}"],
							"path": ["api", "sessions", "{{session_id}}", "messages"]
						},
						"description": "Send a prompt to the agent. Returns a Server-Sent Event (SSE) stream with real-time updates: tool calls, tool results, child agent activity, and the final response.\n\nSSE Event Types:\n- agent_start: Agent turn has begun\n- iteration: Agent loop iteration number\n- tool_call: Agent is invoking a tool (includes tool name and arguments)\n- tool_result: Tool execution result\n- child_start / child_end: Child agent lifecycle\n- done: Agent content is ready\n- error: An error occurred\n- complete: Final event with full turn result (tokens, duration, tools used)\n\nNote: Postman's built-in SSE support will show the event stream. For programmatic use, parse each event block separated by blank lines."
					},
					"response": [
						{
							"name": "Send Prompt — SSE Stream",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "text/event-stream"
								},
								{
									"key": "Cache-Control",
									"value": "no-cache"
								},
								{
									"key": "Connection",
									"value": "keep-alive"
								}
							],
							"body": "event: agent_start\ndata: {}\n\nevent: iteration\ndata: {\"number\":1}\n\nevent: tool_call\ndata: {\"id\":\"call_abc\",\"tool\":\"list_dir\",\"arguments\":{\"path\":\"src\"}}\n\nevent: tool_result\ndata: {\"content\":\"Agent/\\nApi/\\nCommand/\\nConfig/\",\"success\":true}\n\nevent: iteration\ndata: {\"number\":2}\n\nevent: done\ndata: {\"content\":\"Here are the directories inside `src/`:\\n\\n- Agent/\\n- Api/\\n- Command/\\n- Config/\"}\n\nevent: complete\ndata: {\"content\":\"Here are the directories inside `src/`:\\n\\n- Agent/\\n- Api/\\n- Command/\\n- Config/\",\"iterations\":2,\"prompt_tokens\":1250,\"completion_tokens\":340,\"total_tokens\":1590,\"duration_ms\":4521,\"tools_used\":[\"list_dir\"],\"child_agent_count\":0,\"restart_requested\":false,\"error\":null}\n\n"
						},
						{
							"name": "Send Prompt — Missing Prompt",
							"status": "Bad Request",
							"code": 400,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"error\": \"Missing or empty \\\"prompt\\\" field\",\n  \"code\": \"missing_field\"\n}"
						},
						{
							"name": "Send Prompt — Session Busy",
							"status": "Conflict",
							"code": 409,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"error\": \"Session already has an active agent run\",\n  \"code\": \"agent_busy\"\n}"
						}
					]
				},
				{
					"name": "Send Prompt (Blocking JSON)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"prompt\": \"What is 2 + 2?\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/sessions/{{session_id}}/messages?stream=false",
							"host": ["{{base_url}}"],
							"path": ["api", "sessions", "{{session_id}}", "messages"],
							"query": [
								{
									"key": "stream",
									"value": "false",
									"description": "Disable SSE streaming. Blocks until the agent completes and returns a JSON response."
								}
							]
						},
						"description": "Send a prompt to the agent with streaming disabled. The request blocks until the agent completes and returns a single JSON response with the full turn result. Use this for clients that do not support SSE."
					},
					"response": [
						{
							"name": "Send Prompt — Blocking JSON Response",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"content\": \"2 + 2 = 4\",\n  \"iterations\": 1,\n  \"prompt_tokens\": 800,\n  \"completion_tokens\": 15,\n  \"total_tokens\": 815,\n  \"duration_ms\": 1200,\n  \"tools_used\": [],\n  \"child_agent_count\": 0,\n  \"restart_requested\": false,\n  \"error\": null\n}"
						}
					]
				}
			]
		},

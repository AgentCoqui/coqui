{
	"info": {
		"_postman_id": "coqui-api-collection",
		"name": "Coqui API",
		"description": "Complete API collection for the Coqui HTTP API server. Covers session management, agent prompt submission with SSE streaming, turn inspection, configuration, and credential management.\n\nSet the `base_url` and `api_key` variables before using.",

# Dependencies (installed inside container)
vendor/

# Workspace (managed by Coqui at runtime)
.workspace/

# User config (mounted as volumes)
openclaw.json
openclaw-*.json
.env

# Git
.git/
.github/
.gitattributes
.gitignore

# Contributor and editor files
.claude/
AGENTS.md
CLAUDE.md
CHANGELOG.md
.idea/
.vscode/
*.swp
*.swo
*~

# Cache and build artifacts
*.cache
.phpunit.result.cache
.phpstan-cache/
BUILD/

# Tests (not needed in production image)
tests/
smoke-test/
examples/
scripts/
phpstan.neon
phpunit.xml

# Docker files (not needed in build context)
compose*.yaml
Makefile
.dockerignore
Dockerfile

# OS files
.DS_Store
Thumbs.db

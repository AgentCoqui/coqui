# =============================================================================
# Coqui — Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# All values shown are defaults — you only need to set what you want to change.
# =============================================================================

# Project name (used as container/volume prefix)
COMPOSE_PROJECT_NAME=coqui

# =============================================================================
# Container User
# =============================================================================
# Match your host UID/GID to avoid file permission issues with bind mounts.
# Find yours with: id -u && id -g
COQUI_UID=1000
COQUI_GID=1000

# =============================================================================
# API Keys
# =============================================================================
# Pass provider API keys from the host environment.
# These are forwarded into the container as environment variables.
# Alternatively, configure them in openclaw.json.
#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# Ollama
# =============================================================================
# URL for the Ollama instance. Default connects to the host machine.
# If running Ollama in a separate container, use the container name.
OLLAMA_HOST=http://host.docker.internal:11434

# =============================================================================
# Service Networking
# =============================================================================
# API server bind address — use 0.0.0.0 to allow network access (requires API key)
# COQUI_API_HOST=127.0.0.1

# API server — compose.api.yaml / bin/coqui-launcher
COQUI_API_PORT=3300

# Dashboard — compose.dashboard.yaml / bin/coqui-launcher --dashboard
COQUI_DASHBOARD_PORT=3380

# Webgrind (Xdebug profiler viewer) — compose.dev.yaml
COQUI_WEBGRIND_PORT=3390

# =============================================================================
# Runtime Flags
# =============================================================================
# These are env-var equivalents of CLI flags. CLI flags take precedence.
# COQUI_AUTO_APPROVE=false
# COQUI_UNSAFE=false
# COQUI_NO_AUTH=false
# COQUI_VERBOSE=false

# =============================================================================
# Updates
# =============================================================================
# Check for dependency updates on startup (default: true)
COQUI_CHECK_UPDATES=true

# Automatically apply updates on startup (default: false)
# When enabled, Coqui runs `composer update` and restarts if updates are found.
# COQUI_AUTO_UPDATE=false

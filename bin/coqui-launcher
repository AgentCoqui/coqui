#!/usr/bin/env bash
#
# Coqui Launcher — wraps bin/coqui with automatic restart and crash recovery.
#
# Exit code behavior:
#   0  — clean exit (/quit), launcher stops
#   10 — restart requested (/restart or restart_coqui tool), relaunch immediately
#   *  — unexpected crash, relaunch up to MAX_CRASHES consecutive times
#
# Usage:
#   ./bin/coqui-launcher [any options forwarded to bin/coqui]
#
# Examples:
#   ./bin/coqui-launcher
#   ./bin/coqui-launcher --auto-approve
#   ./bin/coqui-launcher -c my-config.json --unsafe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "${SCRIPT_DIR}")"
COQUI_BIN="${SCRIPT_DIR}/coqui"

readonly RESTART_EXIT_CODE=10
readonly MAX_CRASHES=3
readonly GUI_DEFAULT_PORT=8080

crash_count=0

# ─── GUI Mode ────────────────────────────────────────────────────────────────
# Usage: ./bin/coqui-launcher --gui [--port 8080]
#
# Starts the Coqui Dashboard on PHP's built-in server.
# Ctrl+C to stop.

gui_mode=false
gui_port=$GUI_DEFAULT_PORT
remaining_args=()

for arg in "$@"; do
    case $arg in
        --gui)
            gui_mode=true
            ;;
        --port)
            shift_next=true
            ;;
        *)
            if [ "${shift_next:-false}" = true ]; then
                gui_port="$arg"
                shift_next=false
            else
                remaining_args+=("$arg")
            fi
            ;;
    esac
done

if [ "$gui_mode" = true ]; then
    PUBLIC_DIR="${PROJECT_DIR}/public"
    if [ ! -f "${PUBLIC_DIR}/router.php" ]; then
        echo "Error: public/router.php not found. Run 'cd public && composer install' first."
        exit 1
    fi

    # Install composer deps if needed
    if [ ! -d "${PUBLIC_DIR}/vendor" ]; then
        echo "Installing dashboard dependencies..."
        (cd "${PUBLIC_DIR}" && composer install --no-dev --quiet)
    fi

    echo ""
    echo "  Coqui Dashboard"
    echo "  → http://localhost:${gui_port}"
    echo "  Press Ctrl+C to stop"
    echo ""

    # Try to open browser (best effort)
    if command -v xdg-open &>/dev/null; then
        xdg-open "http://localhost:${gui_port}" &>/dev/null &
    elif command -v open &>/dev/null; then
        open "http://localhost:${gui_port}" &>/dev/null &
    fi

    exec php -S "localhost:${gui_port}" -t "${PUBLIC_DIR}" "${PUBLIC_DIR}/router.php"
fi

# ─── REPL Mode (original behavior) ──────────────────────────────────────────
set -- "${remaining_args[@]+"${remaining_args[@]}"}"

# Trap SIGINT/SIGTERM at the launcher level so we exit cleanly
# instead of relaunching when the user hits Ctrl+C during the pause
trap 'echo ""; echo "Launcher stopped."; exit 0' INT TERM

while true; do
    # Run Coqui, forwarding all arguments
    # Disable set -e for this call so we can inspect the exit code
    set +e
    "${COQUI_BIN}" "$@"
    exit_code=$?
    set -e

    case $exit_code in
        0)
            # Clean exit — user typed /quit
            exit 0
            ;;
        $RESTART_EXIT_CODE)
            # Intentional restart — reset crash counter
            crash_count=0
            echo ""
            echo "Restarting Coqui..."
            echo ""
            ;;
        *)
            # Unexpected exit — crash recovery
            crash_count=$((crash_count + 1))

            if [ $crash_count -ge $MAX_CRASHES ]; then
                echo ""
                echo "Coqui has crashed ${MAX_CRASHES} consecutive times (exit code: ${exit_code})."
                echo "Exiting to prevent an infinite crash loop."
                exit $exit_code
            fi

            echo ""
            echo "Coqui exited unexpectedly (exit code: ${exit_code}, attempt ${crash_count}/${MAX_CRASHES})."
            echo "Relaunching in 2 seconds... (Ctrl+C to stop)"
            sleep 2
            ;;
    esac
done

#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use Composer\InstalledVersions;
use CoquiBot\Coqui\Command\ApiCommand;
use CoquiBot\Coqui\Command\DoctorCommand;
use CoquiBot\Coqui\Command\RunCommand;
use CoquiBot\Coqui\Command\SetupCommand;
use CoquiBot\Coqui\Command\TaskRunCommand;
use CoquiBot\Coqui\Command\TurnRunCommand;
use Symfony\Component\Console\Application;

$version = InstalledVersions::getPrettyVersion('coquibot/coqui') ?? 'dev';
$app = new Application('coqui', $version);
$app->add(new RunCommand());
$app->add(new SetupCommand());
$app->add(new DoctorCommand());
$app->add(new ApiCommand());
$app->add(new TaskRunCommand());
$app->add(new TurnRunCommand());
$app->setDefaultCommand('run');
$app->run();
